{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://radoxai.com https://raw.githubusercontent.com; media-src 'self' blob: data: https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "Access-Control-Allow-Origin", "value": "https://www.lumiappio.tech" },
        { "key": "Vary", "value": "Origin" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(home|library|personal|reader|hub|history|review|flashcards|planner|focus|stats|glossary|outlines|auth|login|signup|video|source|notes|course|quiz)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/source/home.html"
    },
    {
      "source": "/home",
      "destination": "/frontend/source/home.html"
    },
    {
      "source": "/library",
      "destination": "/frontend/source/library.html"
    },
    {
      "source": "/personal",
      "destination": "/frontend/source/personal.html"
    },
    {
      "source": "/reader",
      "destination": "/frontend/source/reader.html"
    },
    {
      "source": "/hub",
      "destination": "/frontend/source/hub.html"
    },
    {
      "source": "/history",
      "destination": "/frontend/source/history.html"
    },
    {
      "source": "/review",
      "destination": "/frontend/source/review.html"
    },
    {
      "source": "/flashcards",
      "destination": "/frontend/source/flashcards.html"
    },
    {
      "source": "/planner",
      "destination": "/frontend/source/planner.html"
    },
    {
      "source": "/focus",
      "destination": "/frontend/source/focus.html"
    },
    {
      "source": "/stats",
      "destination": "/frontend/source/stats.html"
    },
    {
      "source": "/glossary",
      "destination": "/frontend/source/glossary.html"
    },
    {
      "source": "/outlines",
      "destination": "/frontend/source/outlines.html"
    },
    {
      "source": "/auth",
      "destination": "/frontend/source/auth.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/source/auth.html"
    },
    {
      "source": "/signup",
      "destination": "/frontend/source/auth.html"
    },
    {
      "source": "/video",
      "destination": "/frontend/source/video.html"
    },
    {
      "source": "/source",
      "destination": "/frontend/source/source.html"
    },
    {
      "source": "/notes",
      "destination": "/frontend/source/notes.html"
    },
    {
      "source": "/course",
      "destination": "/frontend/source/course.html"
    },
    {
      "source": "/quiz",
      "destination": "/frontend/source/quiz.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/source/$1"
    }
  ],
  "redirects": [
    {
      "source": "/api/v1/sources/(.*)/file",
      "destination": "https://baenwfcstfywrbanweks.supabase.co/storage/v1/object/public/sources/$1.pdf",
      "permanent": false
    }
  ]
}